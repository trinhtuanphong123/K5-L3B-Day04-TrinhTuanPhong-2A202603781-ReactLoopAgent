# Đặt biến trong shell; file này chỉ là mẫu, Python không tự đọc .env.
# PROVIDER là adapter API (openai | gemini | anthropic | openrouter),
# không phải tên biến chứa key.
export PROVIDER=openrouter
# MODEL là model ID đầy đủ trên OpenRouter và phải hỗ trợ tool calling.
export MODEL=deepseek/deepseek-v4.1-flash-1017
export OPENROUTER_API_KEY=YOUR_KEY
# Ghim upstream + quantization trên OpenRouter; bỏ dòng này để OpenRouter tự route.
export OPENROUTER_PROVIDER=wafer/mxfp4

# Các provider khác: chỉ cần biến của provider đang dùng.
# export PROVIDER=openai
# export OPENAI_API_KEY=YOUR_KEY
# export GEMINI_API_KEY=YOUR_KEY
# export ANTHROPIC_API_KEY=YOUR_KEY
# export MODEL=YOUR_TOOL_CALLING_MODEL
# Windows PowerShell: $env:PROVIDER='openrouter'; $env:MODEL='...'; $env:OPENROUTER_API_KEY='...'
